---
layout: default
---
<style>
  /* --- CV page overrides ------------------------------------------------- */

  /* Section headings: smaller and unbolded. The markup is
     `<h3 class="card-title font-weight-medium">`, i.e. 2rem at weight 500.
     These are plain (non-!important) utilities in Tailwind's layers, and
     unlayered declarations beat layered ones for normal declarations, so this
     wins without needing !important. */
  .cv .card .card-title {
    font-size: 1.5rem;
    font-weight: 200;
  }

  /* The organisation line under each position/degree ("Worcester Polytechnic
     Institute" beneath "Research Assistant"): smaller, and tucked closer to
     the title above it.

     The template writes `style="font-size: 0.95rem"` straight onto that h6, so
     !important is required -- an author !important declaration outranks a
     normal inline style. (Unlike the `.mt-2` case further down, the competitor
     here is an inline *normal* declaration, not a layered !important, so this
     one does win.) */
  .cv .card .list-group-item h6:not(.title) {
    font-size: 0.85rem !important;
  }

  /* Default h6 margin-bottom is 0.5rem, which left an 8px gap under the title. */
  .cv .card .list-group-item h6.title {
    margin-bottom: 0.15rem;
  }

  /* Paper/site links, between the date line and the highlights
     (see _includes/cv/projects.liquid). Tight under the date it belongs to,
     with a clear gap before the bullets that follow. */
  .cv .card .project-dates {
    margin-bottom: 0;
  }

  .cv .card .project-links {
    margin-top: 0;
    margin-bottom: 0.6rem;
    font-size: 0.8rem;
  }

  .cv .card .project-links-sep {
    color: var(--global-text-color-light);
    padding: 0 0.15rem;
  }

  /* No scrollbar in the table-of-contents sidebar. tocbot's own stylesheet
     ships `.toc { overflow-y: auto }`, which clips the list and adds an inner
     scrollbar; let the sidebar grow to its natural height instead. */
  #toc-sidebar.toc {
    overflow-y: visible;
    max-height: none;
  }

  /* No rules around the date/location cells. main.css applies
     `table:not(.table) td { border-top: 1px solid ... }` to *every* table cell,
     and the date column is a `table.table-cv`, so each row drew a line above
     itself -- reading as a border above and below the date badge. */
  .cv .card table.table-cv td,
  .cv .card table.table-cv th {
    border-top: 0;
  }

  /* No list marker next to each entry. This build never sets
     `list-style: none` on `.list-group` / `.list-group-item`, so every
     Education/Experience/Project entry rendered with a default disc bullet in
     the left margin, beside the date. */
  .cv .card .list-group-item {
    list-style: none;
  }

  /* ...but keep the bullets on the achievement lists inside an entry.
     `list-style-type` inherits, so this has to be restored explicitly. */
  .cv .card ul.items {
    list-style-type: disc;
    /* Default 1rem bottom margin left the links line 16px below its own
       bullets while the next entry started 0px under it, so the links read as
       a heading for the *following* project. Pull the list in tight and let
       the rule below do the separating instead. */
    margin-bottom: 0.3rem;
  }

  /* Separate entries from each other, now that the lists no longer do it. */
  .cv .card .list-group-item + .list-group-item {
    margin-top: 1.1rem;
  }

  /* Line the date/location column up down the page.
     The template centres the date badge and the location inside a
     `table.table-cv` that is only as wide as its own content, so rows with
     different text lengths ("2024 - present" vs "2021 - 2023",
     "Chicago, IL" vs "Worcester, MA") each started at a different x position.
     Sizing the badge to the column does not work: the column's width is eaten
     by 30px of gutter and 4px of border-spacing before the badge sees it, so
     `width: 100%` left the nowrap text spilling outside the coloured
     background. Instead pin the badge and location to one explicit width and
     let the column size itself to them. --date-col-width must clear the
     longest label, "2024 - present", which needs ~116px with the badge's
     padding included. */
  .cv .card {
    --date-col-width: 8rem;
  }

  @media (min-width: 576px) {
    .cv .card .row > .date-column {
      flex: 0 0 auto;
      width: auto;
      max-width: none;
      /* Drop the theme's -5px vertical nudge (see the top-alignment note) and
         match the 8px the body column gets from `mt-2`. */
      transform: translateX(-15px);
      margin-top: 0.5rem;
    }

    /* Give the leftover width back to the entry body. */
    .cv .card .row > .date-column + [class*="col-"] {
      flex: 1 1 0;
      max-width: none;
    }
  }

  /* Why match `mt-2` rather than cancel it: the body column is marked
     `mt-2 mt-md-0`, and `mt-md-0` loses because `.mt-2`'s !important rule is
     emitted later in Tailwind's `components` layer. Overriding it from here is
     not possible either -- cascade layers *invert* !important precedence, so a
     layered !important always beats an unlayered one no matter how specific.
     Adding the same 0.5rem to the date column sidesteps the whole fight. */

  .cv .card .date-column table.table-cv {
    width: auto;
    table-layout: auto;
    /* Table chrome pushed the badge down 3px relative to the row box. */
    border-spacing: 0;
  }

  .cv .card .date-column table.table-cv td {
    padding: 0;
  }

  /* Identical box for every date range, so all four edges line up. */
  .cv .card .date-column .badge {
    display: block;
    width: var(--date-col-width);
    box-sizing: border-box;
  }

  /* Location sits directly under the badge in a box of the same width, so the
     two share both edges and the column reads as one straight stack. */
  .cv .card .date-column p.location {
    width: var(--date-col-width);
    box-sizing: border-box;
    text-align: center;
    /* Replaces the gap the removed cell padding used to provide. */
    margin-top: 0.35rem;
    margin-bottom: 0;
  }
</style>

{% assign cv_feature_enabled = site.al_folio.features.cv.enabled | default: true %}

{% if site.plugins contains 'al_folio_cv' and cv_feature_enabled %}
  {% al_folio_cv_render %}
{% else %}
  <div class="post">
    <header class="post-header">
      <h1 class="post-title">{{ page.title }}</h1>
      <p class="post-description">CV rendering is unavailable.</p>
    </header>
    <article>
      <p>Enable the <code>al_folio_cv</code> plugin and set <code>al_folio.features.cv.enabled: true</code> to render this page.</p>
    </article>
  </div>
{% endif %}
